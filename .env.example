# Домен без https://. Для временной проверки по IP используйте :80 (только HTTP).
DOMAIN=bokobok.example.ru

# Разрешает вывод одноразового кода только в локальный серверный лог.
BOKOBOK_LOG_OTP=0

# Ключ SMS.RU (не передавайте в браузер и не коммитьте .env).
SMS_RU_API_ID=

# Временный вход по паролю без SMS. На сервере работает только через HTTPS.
BOKOBOK_DISABLE_SMS_2FA=0
